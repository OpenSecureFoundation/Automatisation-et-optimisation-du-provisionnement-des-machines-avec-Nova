  "description": "Backend API for VM Marketplace using OpenStack",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node -e \"require('dotenv').config(); require('./models').runMigrations().then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand"
  },
