# ─── OpenStack ───────────────────────────────────────────────────────────────
OS_USERNAME=admin
OS_PASSWORD=YourSecurePassword123!
OS_PROJECT_NAME=admin
KEYSTONE_URL=http://45.9.191.91/identity/v3
NOVA_URL=http://45.9.191.91/compute/v2.1
GLANCE_URL=http://45.9.191.91/image
NEUTRON_URL=http://45.9.191.91/networking

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=remplacer_par_une_valeur_aleatoire_longue_en_prod

# Clé secrète pour permettre la création de comptes admin depuis l'UI.
# Si non définie : création admin autorisée en dev, bloquée en production.
# En production, définir une valeur forte et la communiquer aux admins uniquement.
ADMIN_REGISTRATION_SECRET=fsfffdfff

# ─── Database ────────────────────────────────────────────────────────────────
# En prod avec PostgreSQL :
# DATABASE_URL=postgresql://user:password@localhost:5432/vmmarketplace
# En dev (SQLite par défaut si DATABASE_URL absent) :
# SQLITE_PATH=./database.sqlite
# DB_ALTER=false

# ─── Facturation ─────────────────────────────────────────────────────────────
# IMPORTANT: BILLING_JOB_INTERVAL_MS (server.js) et SLICE_MINUTES (billingEngine.js)
# doivent être cohérents. Valeur par défaut : 30 minutes.
# BILLING_OVERDUE_AFTER_DAYS=7

# ─── Métriques OpenStack (optionnel) ─────────────────────────────────────────
# Gnocchi (séries temporelles - recommandé)
# GNOCCHI_URL=http://45.9.191.91:8041
# GNOCCHI_TIMEOUT_MS=12000
# GNOCCHI_RETRIES=1
# GNOCCHI_ERROR_THROTTLE_MS=60000

# Ceilometer (pipeline vers Gnocchi)
# CEILOMETER_URL=http://45.9.191.91:8777

# Cache OpenStack
# OPENSTACK_CACHE_TTL_MS=30000
# OPENSTACK_TIMEOUT_MS=15000

# ─── noVNC (optionnel) ───────────────────────────────────────────────────────
# NOVA_CONSOLE_MICROVERSION=2.6
# NOVNC_PUBLIC_BASE_URL=http://45.9.191.91:6080

# ─── SSE Métriques live ──────────────────────────────────────────────────────
# METRICS_STREAM_INTERVAL_MS=10000

# ─── Rate limiting ───────────────────────────────────────────────────────────
# TRUST_PROXY_HOPS=1
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=60
# AUTH_RATE_LIMIT_SKIP_SUCCESS=true
# API_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=1200

# ─── Multi-tenant Keystone ───────────────────────────────────────────────────
# KEYSTONE_MULTI_TENANT=true
