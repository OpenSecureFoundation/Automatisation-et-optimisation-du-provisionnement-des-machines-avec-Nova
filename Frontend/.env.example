# Copiez ce fichier en .env à la racine de Frontend/

# URL de l'API (base seulement, sans /api). Le front envoie /api/auth/login etc.
#
# - Depuis la MÊME machine (backend + navigateur sur le même PC) :
#   REACT_APP_API_URL=http://localhost:3001
#
# - Depuis une AUTRE machine (navigateur sur ton PC, backend sur un serveur) :
#   Soit laisser VIDE (recommandé) : pas de .env ou REACT_APP_API_URL=
#   Puis ouvrir l'app via l'IP du serveur : http://IP_DU_SERVEUR:3000
#   Les requêtes /api/... iront vers le serveur et le proxy les enverra au backend.
#
#   Soit mettre l'URL du serveur : REACT_APP_API_URL=http://IP_DU_SERVEUR:3001
#   (il faut alors que le port 3001 soit ouvert et CORS autorise cette origine)
#
REACT_APP_API_URL=http://localhost:3001

# Port du serveur de développement (optionnel)
PORT=3000

# Désactive le chargement des source maps tierces en dev/build CRA
# (évite les erreurs source-map-loader sur certains packages)
GENERATE_SOURCEMAP=false

# OAuth (optionnel – quand le backend exposera une route de connexion Google)
# REACT_APP_GOOGLE_CLIENT_ID=
